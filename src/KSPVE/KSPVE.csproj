<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>KSPVE</AssemblyName>
    <RootNamespace>KSPVE</RootNamespace>
    <KSPManaged>$(KSPDIR)\KSP_x64_Data\Managed</KSPManaged>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KSPVE.Pure\KSPVE.Pure.csproj" />
  </ItemGroup>
  <!-- KSPVE_NO_PAINTER=true leaves the cloud painter out (while it is still being written). -->
  <ItemGroup Condition="'$(KSPVE_NO_PAINTER)' == 'true'">
    <Compile Remove="Painter\**" />
  </ItemGroup>
  <!-- KSPVE_STABLE=true builds only what has been tried in game (the features still being brought up left out), for a
       safe deploy to a player's install while the rest is finished. -->
  <ItemGroup Condition="'$(KSPVE_STABLE)' == 'true'">
    <Compile Remove="Clouds\**;CloudFx\**;EveModules\**;Climate\**;Skies\**;Water\**;Stars\**;Aurora\**;Fluids\**;Post\**;Space\Structure*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(KSPManaged)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(KSPManaged)\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(KSPManaged)\UnityEngine*.dll" Private="false" />
  </ItemGroup>
</Project>
